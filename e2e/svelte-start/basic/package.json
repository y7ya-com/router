{
  "name": "tanstack-svelte-start-e2e-basic",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:e2e": "vite dev",
    "build": "pnpm build:vite",
    "preview": "vite preview",
    "start": "node server.js",
    "test:e2e:local": "playwright test --project=chromium",
    "build:vite": "vite build && svelte-check --tsconfig ./tsconfig.json",
    "build:rsbuild": "rsbuild build && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@tanstack/svelte-router": "workspace:^",
    "@tanstack/svelte-router-devtools": "workspace:^",
    "@tanstack/svelte-start": "workspace:^",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.5",
    "js-cookie": "^3.0.5",
    "redaxios": "catalog:",
    "tailwind-merge": "^3.6.0",
    "svelte": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@rsbuild/core": "^2.1.0",
    "@rsbuild/plugin-svelte": "^2.0.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/router-e2e-utils": "workspace:^",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.10.2",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "combinate": "^1.1.11",
    "srvx": "^0.11.9",
    "tailwindcss": "^4.2.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.0.14",
    "svelte-check": "^4.0.0"
  },
  "nx": {
    "metadata": {
      "playwrightModes": [
        {
          "toolchain": "vite",
          "mode": "ssr",
          "shards": 4
        },
        {
          "toolchain": "vite",
          "mode": "spa"
        },
        {
          "toolchain": "vite",
          "mode": "prerender",
          "env": {
            "NODE_OPTIONS": "--import=@tanstack/router-e2e-utils/mock-api"
          }
        },
        {
          "toolchain": "vite",
          "mode": "preview"
        },
        {
          "toolchain": "rsbuild",
          "mode": "ssr"
        }
      ]
    }
  }
}
