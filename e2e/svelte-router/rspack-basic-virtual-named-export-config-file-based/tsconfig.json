{
  "compilerOptions": {
    "target": "ES2020",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "allowJs": true,
    "types": ["svelte"]
  },
  "include": ["src", "tests", "./routes.ts"],
  "exclude": ["node_modules", "dist"]
}
