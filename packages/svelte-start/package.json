{
  "name": "@tanstack/svelte-start",
  "version": "0.0.0-experimental",
  "description": "Full-stack TanStack Start for Svelte \u2014 community port; mirrors @tanstack/vue-start.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y7ya-com/router.git",
    "directory": "packages/svelte-start"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "keywords": [
    "tanstack",
    "svelte",
    "start",
    "router",
    "ssr"
  ],
  "scripts": {
    "clean": "rimraf ./dist",
    "test:types": "svelte-check --tsconfig ./tsconfig.json",
    "build": "svelte-package --input ./src --output ./dist"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "svelte": "./dist/client.js",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client-rpc": {
      "types": "./dist/client-rpc.d.ts",
      "import": "./dist/client-rpc.js"
    },
    "./server-rpc": {
      "types": "./dist/server-rpc.d.ts",
      "import": "./dist/server-rpc.js"
    },
    "./ssr-rpc": {
      "types": "./dist/ssr-rpc.d.ts",
      "import": "./dist/ssr-rpc.js"
    },
    "./client-only": {
      "types": "./dist/client-only.d.ts",
      "import": "./dist/client-only.js"
    },
    "./server-only": {
      "types": "./dist/server-only.d.ts",
      "import": "./dist/server-only.js"
    },
    "./plugin/vite": {
      "types": "./dist/plugin/vite.d.ts",
      "import": "./dist/plugin/vite.js"
    },
    "./plugin/rsbuild": {
      "types": "./dist/plugin/rsbuild.d.ts",
      "import": "./dist/plugin/rsbuild.js"
    },
    "./package.json": "./package.json",
    "./server-entry": {
      "types": "./dist/default-entry/server.d.ts",
      "import": "./dist/default-entry/server.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=12"
  },
  "dependencies": {
    "@tanstack/start-client-core": "workspace:*",
    "@tanstack/start-plugin-core": "workspace:*",
    "@tanstack/start-server-core": "workspace:*",
    "@tanstack/svelte-router": "workspace:*",
    "@tanstack/svelte-start-client": "workspace:*",
    "@tanstack/svelte-start-server": "workspace:*",
    "pathe": "^2.0.3",
    "@tanstack/router-core": "workspace:*"
  },
  "peerDependencies": {
    "@rsbuild/core": "^2.0.0",
    "vite": ">=7.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    }
  }
}
