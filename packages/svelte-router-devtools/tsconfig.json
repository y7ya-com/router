{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "types": ["svelte", "node", "jsx-svelte/jsx"],
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.svelte",
    "tests/**/*.js",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "tests/**/*.svelte",
    "eslint.config.ts",
    "svelte.config.js",
    "vite.config.ts"
  ]
}
