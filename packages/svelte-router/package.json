{
  "name": "@tanstack/svelte-router",
  "version": "0.0.0-experimental",
  "description": "TanStack Router for Svelte 5 — experimental community port; not an official TanStack release. API mirrors @tanstack/solid-router.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y7ya-com/router.git",
    "directory": "packages/svelte-router"
  },
  "homepage": "https://github.com/y7ya-com/router/tree/feat/svelte-router/packages/svelte-router",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "keywords": [
    "tanstack",
    "tanstack-router",
    "svelte",
    "svelte5",
    "svelte-router",
    "router",
    "routing",
    "file-based-routing",
    "type-safe",
    "type-safe-router",
    "client-side-routing",
    "spa",
    "community-port"
  ],
  "scripts": {
    "clean": "rimraf ./dist && rimraf ./coverage && rimraf ./tests/compiled",
    "test:eslint": "eslint",
    "test:types": "svelte-check --tsconfig ./tsconfig.json",
    "compile-tests": "tsx scripts/port-tests/compile-tests.ts",
    "pretest:unit": "pnpm run compile-tests",
    "test:unit": "vitest",
    "pretest:unit:dev": "pnpm run compile-tests",
    "test:unit:dev": "pnpm run test:unit --watch --hideSkippedTests",
    "test:build": "publint --strict && attw --ignore-rules no-resolution --pack .",
    "build": "svelte-package --input ./src --output ./dist"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./ssr/server": {
      "types": "./dist/ssr/server.d.ts",
      "svelte": "./dist/ssr/server.js",
      "import": "./dist/ssr/server.js"
    },
    "./ssr/client": {
      "types": "./dist/ssr/client.d.ts",
      "svelte": "./dist/ssr/client.js",
      "import": "./dist/ssr/client.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@tanstack/history": "workspace:*",
    "@tanstack/router-core": "workspace:*",
    "@tanstack/svelte-store": "^0.12.0",
    "isbot": "^5.1.22"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@typescript-eslint/parser": "^8.44.1",
    "@testing-library/svelte": "^5.2.4",
    "combinate": "^1.1.11",
    "eslint-plugin-svelte": "^3.22.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tsx": "^4.20.0",
    "ts-morph": "^24.0.0",
    "vite": "*",
    "zod": "^4.4.3",
    "@types/node": ">=20"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
